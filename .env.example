# Managed runtime supplies DATABASE_URL when database capability is enabled.
DATABASE_URL=mysql://user:password@host:3306/cbcsce
PORT=3000
NODE_ENV=development

# Required for any state-changing demo API request; never use this as production authentication.
CSCE_DEMO_MUTATION_TOKEN=

# Optional integration credentials. Keep unset in demo mode.
FX_PROVIDER_API_KEY=
SANCTIONS_PROVIDER_API_KEY=
OBJECT_STORAGE_BUCKET=
