# Managed runtime supplies DATABASE_URL when database capability is enabled.
# Local MySQL via docker-compose.yml: see docs/deployment.md for the exact format.
DATABASE_URL=mysql://user:password@host:3306/cbcsce
PORT=3000

# Clerk (https://dashboard.clerk.com → API keys). The publishable key is inlined into the
# client bundle by Vite; the secret key is server-only and must never be a build arg.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional integration credentials. Keep unset in demo mode.
FX_PROVIDER_API_KEY=
SANCTIONS_PROVIDER_API_KEY=
OBJECT_STORAGE_BUCKET=
